{
  "name": "@mzeng062102/biv",
  "version": "1.0.9",
  "description": "Bundle size analyzer for Vite",
  "type": "module",
  "main": "./dist/analyzer.js",
  "types": "./dist/analyzer.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "biv": "./dist/cli.js"
  },
  "scripts": {
    "cli": "FORCE_COLOR=1 tsx cli.ts",
